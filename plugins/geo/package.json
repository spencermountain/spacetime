{
  "name": "spacetime-geo",
  "version": "1.3.0",
  "description": "determine a timezone from a lat/lng",
  "license": "MIT",
  "repository": "github:spencermountain/spacetime",
  "homepage": "https://github.com/spencermountain/spacetime/tree/master/plugins/geo",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "require": "./builds/spacetime-geo.cjs",
      "import": "./builds/spacetime-geo.mjs",
      "default": "./builds/spacetime-geo.mjs"
    }
  },
  "main": "./builds/spacetime-geo.cjs",
  "sideEffects": false,
  "scripts": {
    "watch": "node --watch ./scratch.js",
    "test": "\"node_modules/.bin/tape\" \"./tests/*.test.js\" | \"node_modules/.bin/tap-dancer\" --color",
    "download": "node ./scripts/download.js",
    "version": "node ./scripts/version.js",
    "build": "node ./scripts/version.js && rollup -c --silent"
  },
  "files": [
    "builds"
  ],
  "keywords": [
    "timezone"
  ],
  "dependencies": {
    "@photostructure/tz-lookup": "11.7.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@turf/simplify": "^7.3.5",
    "rollup": "catalog:",
    "tap-dancer": "catalog:",
    "tape": "catalog:"
  },
  "unpkg": "./builds/spacetime-geo.min.js",
  "peerDependencies": {
    "spacetime": "workspace:>=7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
