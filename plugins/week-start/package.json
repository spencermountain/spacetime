{
  "name": "spacetime-week-start",
  "version": "0.4.0",
  "description": "calculate start-of-week",
  "license": "MIT",
  "repository": "github:spencermountain/spacetime",
  "homepage": "https://github.com/spencermountain/spacetime/tree/master/plugins/week-start",
  "author": "Martin Spodniak & Spencer Kelly",
  "type": "module",
  "exports": {
    ".": {
      "require": "./builds/spacetime-week-start.cjs",
      "import": "./builds/spacetime-week-start.mjs",
      "default": "./builds/spacetime-week-start.mjs"
    }
  },
  "main": "./src/index.js",
  "module": "./builds/spacetime-week-start.mjs",
  "sideEffects": false,
  "scripts": {
    "watch": "node --watch ./scratch.js",
    "test": "tape './test/**/*.test.js' | tap-dancer --color",
    "version": "node ./scripts/version.js",
    "build": "node ./scripts/version.js && rollup -c --silent"
  },
  "files": [
    "builds"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "catalog:",
    "rollup": "catalog:",
    "tap-dancer": "catalog:",
    "tape": "catalog:"
  },
  "peerDependencies": {
    "spacetime": "workspace:>=7.0.0"
  },
  "unpkg": "builds/spacetime-week-start.min.js",
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
