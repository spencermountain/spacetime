{
  "name": "spacetime-week-of-month",
  "version": "0.2.0",
  "description": "calculate nth week of the month",
  "license": "MIT",
  "repository": "github:spencermountain/spacetime",
  "homepage": "https://github.com/spencermountain/spacetime/tree/master/plugins/spacetime-week-of-month",
  "type": "module",
  "exports": {
    ".": {
      "require": "./builds/spacetime-week-of-month.cjs",
      "import": "./builds/spacetime-week-of-month.mjs",
      "default": "./builds/spacetime-week-of-month.mjs"
    }
  },
  "main": "./src/index.js",
  "module": "./builds/spacetime-week-of-month.mjs",
  "sideEffects": false,
  "scripts": {
    "test": "tape './week.test.js' './tests/*.test.js' | tap-dancer --color",
    "version": "node ./scripts/version.js",
    "build": "node ./scripts/version.js && rollup -c --silent"
  },
  "files": [
    "builds"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "catalog:",
    "rollup": "catalog:",
    "tap-dancer": "catalog:",
    "tape": "catalog:"
  },
  "unpkg": "builds/spacetime-week-of-month.min.js",
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "peerDependencies": {
    "spacetime": "workspace:>=7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
