{
  "name": "spacetime-timer",
  "version": "0.0.1",
  "description": "playback a spacetime object at real-rate, without drift",
  "license": "MIT",
  "repository": "github:spencermountain/spacetime",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "minimumReleaseAge": "1 day",
  "type": "module",
  "exports": {
    ".": {
      "require": "./builds/spacetime-timer.cjs",
      "import": "./builds/spacetime-timer.mjs",
      "default": "./builds/spacetime-timer.mjs"
    }
  },
  "main": "./src/index.js",
  "module": "./builds/spacetime-timer.mjs",
  "sideEffects": false,
  "scripts": {
    "watch": "node --watch ./scratch.js",
    "test": "tape './test/**/*.test.js' | tap-dancer --color",
    "version": "node ./scripts/version.js",
    "build": "node ./scripts/version.js && rollup -c --silent"
  },
  "files": [
    "builds"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "catalog:",
    "rollup": "catalog:",
    "tap-dancer": "catalog:",
    "tape": "catalog:"
  },
  "peerDependencies": {
    "spacetime": "workspace:>=7.0.0"
  },
  "unpkg": "builds/spacetime-timer.min.js",
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
