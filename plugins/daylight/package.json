{
  "name": "spacetime-daylight",
  "version": "1.5.2",
  "description": "calculate approximate sunlight times for a given timezone",
  "license": "MIT",
  "repository": "github:spencermountain/spacetime",
  "homepage": "https://github.com/spencermountain/spacetime/tree/master/plugins/spacetime-daylight",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "require": "./builds/spacetime-daylight.cjs",
      "import": "./builds/spacetime-daylight.mjs",
      "default": "./builds/spacetime-daylight.mjs"
    }
  },
  "main": "./builds/spacetime-daylight.mjs",
  "module": "./builds/spacetime-daylight.mjs",
  "sideEffects": false,
  "scripts": {
    "watch": "node --watch ./scratch.js",
    "test": "tape './tests/*.test.js' | tap-dancer --color",
    "version": "node ./scripts/version.js",
    "build": "node ./scripts/version.js && rollup -c --silent"
  },
  "keywords": [
    "sunlight",
    "timezone"
  ],
  "dependencies": {
    "spacetime-geo": "workspace:^",
    "suncalc": "1.9.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "rollup": "catalog:",
    "tap-dancer": "catalog:",
    "tape": "catalog:"
  },
  "unpkg": "builds/spacetime-daylight.min.js",
  "peerDependencies": {
    "spacetime": "workspace:>=7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
