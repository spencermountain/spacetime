{
  "name": "spacetime",
  "version": "7.16.0",
  "description": "figure-out dates across timezones",
  "license": "Apache-2.0",
  "repository": "github:spencermountain/spacetime",
  "homepage": "https://spacetime.how",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/spacetime.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/spacetime.cjs"
      }
    },
    "./temporal": {
      "import": {
        "types": "./types/temporal.d.ts",
        "default": "./builds/spacetime-temporal.mjs"
      },
      "require": {
        "types": "./types/temporal.d.cts",
        "default": "./builds/spacetime-temporal.cjs"
      }
    }
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node ./zonefile/pack.js && node ./scripts/version.js && rollup -c --silent",
    "build:tz": "node ./scripts/tz/update.js",
    "pack": "node ./zonefile/pack.js",
    "version": "node ./scripts/version.js",
    "watch": "node --watch ./scratch.js",
    "test": "tape --strict './tests/**/*.test.js' | tap-dancer --color always",
    "testb": "TESTENV=prod tape --strict './tests/**/*.test.js' | tap-dancer --color always",
    "test:temporal": "TESTENV=temporal tape --strict tests/temporal/_require.js './tests/temporal/*.test.js' './tests/temporal-build/*.test.js' './tests/integration/temporal*.test.js' | tap-dancer --color always",
    "testb:temporal": "TESTENV=temporal-prod tape --strict tests/temporal/_require.js './tests/temporal/*.test.js' './tests/temporal-build/*.test.js' './tests/integration/temporal*.test.js' | tap-dancer --color always",
    "test:temporal:types": "tsc --project tests/temporal-types/tsconfig.json",
    "test:temporal:all": "node scripts/audit-temporal.js",
    "check:types": "tsc --project ./tests/types/tsconfig.json",
    "test:types": "pnpm check:types && node --import tsx ./tests/types/index.ts | tap-dancer --color always",
    "test:release": "node ./scripts/check-release.js",
    "coverage": "nyc -r lcov -n 'src/**/*' -n 'plugins/**/*' npm run coverage:tests",
    "coverage:tests": "npm run test",
    "lint": "eslint ./src ./scripts ./tests"
  },
  "files": [
    "api",
    "builds",
    "src",
    "types",
    "zonefile"
  ],
  "keywords": [
    "date-time",
    "timezone",
    "daylight-savings"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^26.6.4",
    "@types/tape": "^5.8.1",
    "eslint": "^10.11.0",
    "eslint-plugin-regexp": "3.3.1",
    "rollup": "4.63.5",
    "rollup-plugin-filesize-check": "2.0.1",
    "tap-dancer": "0.4.3",
    "tape": "5.10.2",
    "timekeeper": "2.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "unpkg": "builds/spacetime.min.js",
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  }
}
