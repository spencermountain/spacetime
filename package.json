{
  "name": "spacetime",
  "version": "7.16.0",
  "description": "figure-out dates across timezones",
  "license": "Apache-2.0",
  "repository": "github:spencermountain/spacetime",
  "homepage": "https://spacetime.how",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/spacetime.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/spacetime.cjs"
      }
    },
    "./temporal": {
      "import": {
        "types": "./types/temporal.d.ts",
        "default": "./builds/spacetime-temporal.mjs"
      },
      "require": {
        "types": "./types/temporal.d.cts",
        "default": "./builds/spacetime-temporal.cjs"
      }
    }
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "watch": "node --watch ./scratch.js",
    "pack": "node ./zonefile/pack.js",
    "version": "node ./scripts/version.js",
    "build": "pnpm run pack && pnpm run version && rollup -c --silent",
    "build:tz": "node ./scripts/tz/update.js",
    "test": "tape --strict './tests/**/*.test.js' | tap-dancer",
    "testb": "TESTENV=prod pnpm run test",
    "test:plugins": "pnpm --filter \"./plugins/*\" run test",
    "test:temporal": "TESTENV=temporal tape --strict tests/temporal/_reporter.js './tests/temporal/*.test.js' './tests/integration/temporal*.test.js'",
    "test:types": "tsc --project ./tests/types/tsconfig.json && node --import tsx ./tests/types/index.ts | tap-dancer",
    "test:all": "pnpm run test && pnpm run test:temporal && pnpm run test:types && pnpm run test:plugins && pnpm run lint",
    "bench": "node ./scripts/bench/index.js",
    "bench:write": "node ./scripts/bench/index.js --write",
    "lint": "eslint ."
  },
  "files": [
    "api",
    "builds",
    "src",
    "types",
    "zonefile"
  ],
  "keywords": [
    "date-time",
    "timezone",
    "daylight-savings"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "catalog:",
    "@types/node": "^26.6.5",
    "@types/tape": "^5.8.1",
    "eslint": "^10.12.0",
    "eslint-plugin-regexp": "3.3.1",
    "rollup": "catalog:",
    "rollup-plugin-filesize-check": "2.0.1",
    "tap-dancer": "catalog:",
    "tape": "catalog:",
    "timekeeper": "2.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "unpkg": "builds/spacetime.min.js",
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "packageManager": "pnpm@10.26.0"
}
